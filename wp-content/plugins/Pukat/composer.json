{
  "name": "flow-beyond/pukat",
  "description": "Pukat — Phishing Simulation Platform WordPress Plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "brain/monkey": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "Pukat\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pukat\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
